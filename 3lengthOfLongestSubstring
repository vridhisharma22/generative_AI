class Solution {
    public int lengthOfLongestSubstring(String s) {
        if (s.length() == 0) {
            return 0;
        }
        String ans = "";
        int i = 0;
        while (i < s.length()) {
            char ch = s.charAt(i);
            if (ans.contains("" + ch)) {
                break;
            }
            ans = ans + ch; 
            i++;
        }
        int len1 = ans.length();
        int len2 = lengthOfLongestSubstring(s.substring(1));
        if (len1 > len2) {
            return len1;
        } else {
            return len2;
        }
    }
}
