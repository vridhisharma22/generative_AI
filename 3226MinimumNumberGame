#include <stdlib.h>
int* numberGame(int* nums, int numsSize, int* returnSize) {
int i, j, t;
for (i = 0; i < numsSize - 1; i++) {
for (j = 0; j < numsSize - i - 1; j++) {
if (nums[j] > nums[j + 1]) {
t = nums[j + 1];
nums[j + 1] = nums[j];
nums[j] = t;
}
}
}
for (i = 0; i < numsSize; i += 2) {
t = nums[i];
nums[i] = nums[i + 1];
nums[i + 1] = t;
}
*returnSize = numsSize;
return nums;
}
