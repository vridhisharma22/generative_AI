bool checkIfPangram(char* sentence) {
for(char alpha = 'a'; alpha <= 'z'; alpha++) {
int found = 0;
for(int i = 0; sentence[i] != '\0'; i++) {
char ch = sentence[i];
if(ch >= 'A' && ch <= 'Z') {
ch = ch + 32;
}
if(ch == alpha) {
found = 1;
break;
}
}
}
if(found == 0) {
return false;
}
return true;
}
